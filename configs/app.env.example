HTTP_ADDR=127.0.0.1:8000
DATABASE_URL=postgresql://esp:CHANGE_ME@localhost:5433/esp_app
DB_POOL_SIZE=5
API_KEY=
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PARAM_DICT_PATH=parameters_dict.json
ML_SERVICE_TARGET=127.0.0.1:50051
ML_SERVICE_API_KEY=CHANGE_ME
ML_SERVICE_TIMEOUT_S=300
ML_AUTORUN_ENABLED=false
ML_AUTORUN_HOUR=5
TZ=Europe/Moscow
METABASE_SITE_URL=
METABASE_EMBED_SECRET=
METABASE_DASHBOARDS=[]
METABASE_TOKEN_TTL_S=3600
# Интеграции: точные имена разрешённых серверов, без схем и портов.
INTEGRATION_ALLOWED_HOSTS=127.0.0.1,localhost
# Отдельный от БД постоянный ключ: 32 случайных байта в base64. Пусто — секреты не сохраняются.
INTEGRATION_SECRET_KEY=

# Pulse Data: чтение архива и показательного фонда в существующих карточках.
TELEMETRY_DATA_API_URL=http://127.0.0.1:8092

# legacy сохраняет общий API-ключ/локальный сеанс. local включает персональные роли.
# Перед переключением явно примените миграции и создайте первого администратора через bin/adminuser.
AUTH_MODE=local
# В HTTPS оставить true. Только для разработки на loopback HTTP допустимо false.
AUTH_COOKIE_SECURE=true

# Пользовательский профиль: только сохранённое membership. Research выбирают явно.
APP_SCOPE=cohort
COHORT_VERSION=presentation-v1
