<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Pulse architecture" version="24.7.17" type="device">
  <diagram id="context" name="C1 · Контекст системы">
    <mxGraphModel dx="1450" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="context-1" value="C1 · Контекст системы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=26;fontColor=#25344A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1370" height="42" as="geometry" />
        </mxCell>
        <mxCell id="context-2" value="Область: Пульс скважины. Пользователи и внешнее окружение; внутренние приложения раскрыты на странице C2." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=14;fontColor=#25344A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1370" height="44" as="geometry" />
        </mxCell>
        <mxCell id="context-3" value="&lt;b style=&quot;font-size:18px&quot;&gt;Технолог&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Человек]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Следит за фондом, изучает телеметрию,&lt;br&gt;проверяет тревоги и фиксирует заключение&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="context-4" value="&lt;b style=&quot;font-size:18px&quot;&gt;Администратор&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Человек]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Управляет фондом, пользователями,&lt;br&gt;источниками и сопоставлением полей&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="context-5" value="&lt;b style=&quot;font-size:18px&quot;&gt;Пульс скважины&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Программная система]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Предиктивная диагностика УЭЦН.&lt;br&gt;Реестр, сбор, графики, ручные проверки&lt;br&gt;моделью и история решений&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="510" y="320" width="370" height="220" as="geometry" />
        </mxCell>
        <mxCell id="context-6" value="&lt;b style=&quot;font-size:18px&quot;&gt;Архив промысловых данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внешняя программная система]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Историческая телеметрия,&lt;br&gt;метаданные и суточный дебит&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#6B7280;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1110" y="320" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="context-7" value="Изучает и проверяет&lt;br&gt;[Web]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#526276;strokeWidth=1.7;fontFamily=Helvetica;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="context-3" target="context-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="context-8" value="Настраивает и управляет&lt;br&gt;[Web]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#526276;strokeWidth=1.7;fontFamily=Helvetica;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="context-4" target="context-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="context-9" value="Читает доступные данные&lt;br&gt;[API / запросы к хранилищам]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#526276;strokeWidth=1.7;fontFamily=Helvetica;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="context-5" target="context-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="context-10" value="Файловый сценарий: технолог/администратор загружает CSV, XLSX или Parquet через интерфейс Pulse; выгружает выбранные данные.&lt;br&gt;Внешние ID используются для связывания источников; пользователь работает с ID Pulse." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="650" width="960" height="90" as="geometry" />
        </mxCell>
        <mxCell id="context-11" value="Целевое расширение: Keycloak / другой IdP по OIDC/SSO. В текущем локальном запуске SSO не подключён; AUTH_MODE=legacy. Не показан как действующая связь." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="760" width="960" height="70" as="geometry" />
        </mxCell>
        <mxCell id="context-12" value="Обозначения: синий — часть Pulse · тёмно-синий — человек · серый — внешняя система/контейнер. Стрелка: инициатор → используемый элемент; подпись — назначение и протокол. Пунктирная рамка — граница системы или контейнера." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1370" height="64" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="containers" name="C2 · Контейнеры и взаимодействия">
    <mxGraphModel dx="1900" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="containers-1" value="C2 · Контейнеры и взаимодействия" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=26;fontColor=#25344A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="containers-2" value="Область: одна система Pulse. Контейнер C4 — приложение или хранилище; библиотеки pulse-model и pulse-contracts не являются отдельными серверами." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=14;fontColor=#25344A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1820" height="44" as="geometry" />
        </mxCell>
        <mxCell id="containers-3" value="&lt;b&gt;Пульс скважины · граница программной системы&lt;/b&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#9AA7B5;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;fontSize=16;fontColor=#334155;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="130" width="1220" height="940" as="geometry" />
        </mxCell>
        <mxCell id="containers-4" value="&lt;b style=&quot;font-size:18px&quot;&gt;Пользователь&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Человек]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Технолог / администратор&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="250" height="135" as="geometry" />
        </mxCell>
        <mxCell id="containers-5" value="&lt;b style=&quot;font-size:18px&quot;&gt;Web-интерфейс&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · React / TypeScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;pulse-frontend · SPA в браузере&lt;br&gt;Фонд, карточки, графики и файлы&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="200" width="290" height="155" as="geometry" />
        </mxCell>
        <mxCell id="containers-6" value="&lt;b style=&quot;font-size:18px&quot;&gt;Web-сервер&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · Nginx]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;pulse-frontend&lt;br&gt;Раздаёт SPA и проксирует /api&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="490" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="containers-7" value="&lt;b style=&quot;font-size:18px&quot;&gt;API и сборщик&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · Go / Gin]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;pulse-backend&lt;br&gt;Доступ, фонд, проверки, заключения,&lt;br&gt;периодический сбор и watermark&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="850" y="350" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="containers-8" value="&lt;b style=&quot;font-size:18px&quot;&gt;ML-сервис&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · Python / gRPC]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;pulse-ml-service&lt;br&gt;Вычисление признаков и риска, SHAP.&lt;br&gt;Использует библиотеку pulse-model&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1230" y="200" width="290" height="165" as="geometry" />
        </mxCell>
        <mxCell id="containers-9" value="&lt;b style=&quot;font-size:18px&quot;&gt;Pulse Data API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · Python / JSON HTTP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;pulse-data&lt;br&gt;Чтение реального архива;&lt;br&gt;генерация показательного фонда&lt;/span&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1230" y="640" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="containers-10" value="&lt;b style=&quot;font-size:18px&quot;&gt;Операционная база&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · PostgreSQL / esp_app]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Реестр, привязки, телеметрия сборщика,&lt;br&gt;проверки, заключения, права и аудит&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="850" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="containers-11" value="&lt;b style=&quot;font-size:18px&quot;&gt;Исследовательские данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · PostgreSQL / esp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Метаданные скважин&lt;br&gt;и суточный дебит&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="850" y="850" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="containers-12" value="&lt;b style=&quot;font-size:18px&quot;&gt;Артефакты и сценарий&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Контейнер · файловое хранилище]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;workspace-data&lt;br&gt;Модели, признаки, профили, manifest.&lt;br&gt;В Docker подключены только для чтения&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1230" y="850" width="290" height="155" as="geometry" />
        </mxCell>
        <mxCell id="containers-13" value="&lt;b style=&quot;font-size:18px&quot;&gt;Архив телеметрии&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внешний контейнер · ClickHouse]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;telemetry&lt;br&gt;Существующий исторический архив&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#6B7280;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1620" y="620" width="250" height="175" as="geometry" />
        </mxCell>
        <mxCell id="containers-14" value="Работает с фондом&lt;br&gt;[Web]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#526276;strokeWidth=1.7;fontFamily=Helvetica;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="containers-4" target="containers-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="containers-15" value="Загружает SPA; отправляет API-запросы&lt;br&gt;[HTTP :8080]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#526276;strokeWidth=1.7;fontFamily=Helvetica;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="containers-5" target="containers-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
