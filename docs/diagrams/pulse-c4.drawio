        <mxCell id="containers-22" value="Читает историческую телеметрию&lt;br&gt;[HTTP SQL :8123]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#526276;strokeWidth=1.7;fontFamily=Helvetica;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="containers-9" target="containers-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="containers-23" value="Читает профили и сценарий&lt;br&gt;[файлы, read-only]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#526276;strokeWidth=1.7;fontFamily=Helvetica;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="containers-9" target="containers-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="containers-24" value="Сбор ≠ скоринг: сборщик периодически получает JSON и сохраняет измерения. Запуск модели выполняется отдельно по команде; в этом Compose ML_AUTORUN_ENABLED=false. Результат сценария генератора не назначает модели риск или ярус." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="1090" width="1220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="containers-25" value="Обозначения: синий — часть Pulse · тёмно-синий — человек · серый — внешняя система/контейнер. Стрелка: инициатор → используемый элемент; подпись — назначение и протокол. Пунктирная рамка — граница системы или контейнера." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="1820" height="64" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
