        <mxCell id="deployment-19" value="Read-only bind mounts: ML ← models, manifest, cache/features_v3; Data ← emulator, telemetry_coverage.csv; Backend ← parameters.local.json.&lt;br&gt;PostgreSQL подключён к backend и ML; ClickHouse — к Pulse Data. Нативный Vite :5174 может использовать Docker API :8000. Локальные порты привязаны к 127.0.0.1." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
