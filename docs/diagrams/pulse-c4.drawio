        </mxCell>
        <mxCell id="components-31" value="Дополнительные адаптеры: spreadsheet — XLSX; parameterfile — словарь параметров; postgres.ExternalTelemetry — чтение внешних БД.&lt;br&gt;Domain содержит типы и инварианты. pulse-contracts поставляет generated SDK. SQL находится только в repository, protobuf — в gRPC-адаптере." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1260" width="1500" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
